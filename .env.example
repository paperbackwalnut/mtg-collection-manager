# Optional local database locations. Defaults are shown below.
# Both files are ignored by Git.
COLLECTION_DB_PATH=./collection.db
SCRYFALL_DB_PATH=./scryfall.db

# Optional startup refresh reminders. Set METADATA_PROMPT=0 to disable all prompts.
SCRYFALL_MAX_AGE_DAYS=7
ORACLE_TAG_MAX_AGE_DAYS=30

# Maximum browser form/upload request size. The launcher defaults to 25M.
BODY_SIZE_LIMIT=25M
